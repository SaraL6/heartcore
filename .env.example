# Copy this file to .env.local and fill in the two values from your Supabase
# project: Dashboard → Project Settings → API.
# The anon key is meant to be public; never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Shown on the terms, privacy and copyright pages so people can reach you.
# Use an address made for the site, not your personal one.
VITE_CONTACT_EMAIL=

# Set to true if the site ever makes money, to hide photos licensed for
# non-commercial use only.
# VITE_COMMERCIAL_LICENSES_ONLY=true

# Optional: use Unsplash for Discover (faster, prettier photos). Paste the
# ACCESS key of your Unsplash app here. Never the secret key.
# VITE_UNSPLASH_ACCESS_KEY=

# Optional: let people connect Spotify to play full songs (Premium, computer
# browsers). Paste the CLIENT ID of your Spotify app here. Never the secret.
# VITE_SPOTIFY_CLIENT_ID=

# Optional: add older photos from Flickr to Discover. Paste the KEY (not the
# secret) of a non-commercial Flickr API key.
# VITE_FLICKR_API_KEY=
